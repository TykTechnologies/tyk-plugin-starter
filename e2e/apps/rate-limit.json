{
  "name": "rate-limit-e2e",
  "api_id": "rate-limit-e2e",
  "org_id": "default",
  "use_keyless": true,
  "active": true,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "custom_middleware_bundle": "rate-limiter.zip",
  "custom_middleware_bundle_disabled": false,
  "proxy": {
    "listen_path": "/ratelimit/",
    "target_url": "http://httpbin:8080/",
    "strip_listen_path": true
  }
}
